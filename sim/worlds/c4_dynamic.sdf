<?xml version="1.0" encoding="UTF-8"?>
<!-- C4 dynamic: a person walks into the landing zone
     Generated by tools/make_worlds.py. Edit that file, not this one. -->
<sdf version="1.9">
  <world name="c4_dynamic">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.3 -0.87</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.4501</latitude_deg>
      <longitude_deg>30.5234</longitude_deg>
      <elevation>150</elevation>
    </spherical_coordinates>

    <!-- Ground. A heightmap is used even for flat worlds because it is the
         one ground type whose grass texture repeats every few metres;
         without visible texture the camera can't tell grass from asphalt. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="terrain_visual">
          <geometry><heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://sl_assets/materials/textures/grass.png</diffuse>
              <normal>model://sl_assets/materials/textures/flat_normal.png</normal>
              <size>10.24</size>
            </texture>
            <uri>model://sl_assets/materials/textures/heightmap_flat.png</uri>
            <size>128.0 128.0 1.0</size>
            <pos>0 0 0</pos>
          </heightmap></geometry>
        </visual>
      </link>
    </model>

    <model name="bush_0">
      <static>true</static>
      <pose>3.0 4.0 0.42 0 0 0</pose>
      <link name="link">
        <collision name='c'><geometry><sphere><radius>0.7</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr><metal>
              <albedo_map>model://sl_assets/materials/textures/foliage.png</albedo_map>
              <roughness>0.9</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="bush_1">
      <static>true</static>
      <pose>10.0 -3.0 0.48 0 0 0</pose>
      <link name="link">
        <collision name='c'><geometry><sphere><radius>0.8</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.8</radius></sphere></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr><metal>
              <albedo_map>model://sl_assets/materials/textures/foliage.png</albedo_map>
              <roughness>0.9</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>8.0 3.0 0.075 0 0 2.372</pose>
      <link name="link">
        <collision name='c'><geometry><box><size>0.25 0.2 0.15</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.25 0.2 0.15</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <pbr><metal>
              <albedo_map>model://sl_assets/materials/textures/rock.png</albedo_map>
              <roughness>0.9</roughness><metalness>0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The walking person. The mesh is downloaded from Gazebo Fuel the
         first time this world is opened, so the first run needs internet. -->
    <actor name="walker">
      <skin><filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename><scale>1.0</scale></skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0.0</time><pose>6.0 -12.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>12.0</time><pose>6.0 -12.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>18.0</time><pose>6.0 0.0 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>22.0</time><pose>6.0 0.0 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>26.0</time><pose>14.0 0.0 1.0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>32.0</time><pose>14.0 -12.0 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>36.0</time><pose>6.0 -12.0 1.0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
